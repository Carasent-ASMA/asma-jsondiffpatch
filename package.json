{
    "name": "asma-jsondiffpatch",
    "version": "1.0.9",
    "description": "Diff & Patch for Javascript objects",
    "homepage": "https://bitbucket.org/carasent/asma-jsondiffpatch#readme",
    "bugs": {
        "url": "https://bitbucket.org/carasent/asma-jsondiffpatch/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+ssh://git@bitbucket.org/carasent/asma-jsondiffpatch.git"
    },
    "license": "UNLICENSED",
    "author": "asma-team",
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "main": "./lib/jsondiffpatch.js",
    "types": "./lib",
    "exports": {
        ".": {
            "import": "./lib/jsondiffpatch.js"
        },
        "./with-text-diffs": "./lib/with-text-diffs.js",
        "./filters/*": "./lib/filters/*.js",
        "./formatters/*": "./lib/formatters/*.js",
        "./formatters/styles/*.css": "./lib/formatters/styles/*.css"
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "build": "npx tsc && vite build ",
        "lint": "biome lint src/**/*.ts",
        "lint:fix": "biome lint --write src/**/*.ts",
        "format": "biome format --write src/**/*.ts",
        "check": "biome check --fix src/**/*.ts",
        "test": "jest --coverage"
    },
    "devDependencies": {
        "@biomejs/biome": "1.9.4",
        "@rollup/plugin-terser": "^0.4.4",
        "@types/diff-match-patch": "^1.0.36",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.13.1",
        "browserslist": "^4.24.4",
        "glob": "^11.0.1",
        "jest": "^29.7.0",
        "lightningcss": "^1.29.1",
        "node": "^20.18.3",
        "ts-jest": "^29.2.5",
        "typescript": "^5.7.3",
        "vite": "^6.1.0",
        "vite-plugin-dts": "^4.5.0",
        "vite-plugin-static-copy": "^2.2.0",
        "vite-tsconfig-paths": "^5.1.4"
    },
    "dependencies": {
        "chalk": "^5.4.1",
        "diff-match-patch": "^1.0.5"
    }
}
